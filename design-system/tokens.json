{
  "name": "Bagi Rata design tokens",
  "version": "2026-10-26",
  "fonts": {
    "display": { "family": "Outfit", "weights": [600, 700, 800], "use": "Judul layar, angka besar (total, tagihan per orang), tombol utama", "source": "https://fonts.google.com/specimen/Outfit" },
    "body": { "family": "Plus Jakarta Sans", "weights": [400, 500, 600, 700], "use": "Semua teks lain: label, isian, catatan", "source": "https://fonts.google.com/specimen/Plus+Jakarta+Sans" },
    "numbers": { "family": "SF Mono / ui-monospace", "use": "Rincian 'cara hitung' saja" }
  },
  "typeScale": {
    "screenTitle": { "font": "display", "size": 32, "weight": 800 },
    "screenSubtitle": { "font": "body", "size": 14, "weight": 400 },
    "sectionTitle": { "font": "display", "size": 13, "weight": 700, "uppercase": true, "letterSpacing": "0.08em" },
    "body": { "font": "body", "size": 17, "weight": 400 },
    "amountLarge": { "font": "display", "size": 19, "weight": 700 },
    "playerAmount": { "font": "display", "size": 18, "weight": 700 },
    "note": { "font": "body", "size": 13, "weight": 500 },
    "tabLabel": { "font": "body", "size": 10.5, "weight": 400 }
  },
  "colors": {
    "chalk": "#f4f2ea",
    "light": { "cell": "#ffffff", "text": "#16201a", "muted": "#69736c", "separator": "#dde2dc", "danger": "#c8372d", "whatsappBubble": "#dcf3c8" },
    "dark": { "cell": "#1b1e1c", "text": "#eef2ee", "muted": "#9ba39d", "separator": "#323833", "danger": "#ff6b5e", "whatsappBubble": "#1f3d24" }
  },
  "courtThemes": {
    "wimbledon": { "label": "Wimbledon", "surface": "grass", "deep": "#193e0c", "base": "#2c580b", "highlight": "#497718", "header": "#193e0c", "accentLight": "#3a7012", "accentDark": "#8cc63f", "texture": "textures/wimbledon-grass.jpg", "mowingStripes": true, "default": true },
    "rolandGarros": { "label": "Roland-Garros", "surface": "clay", "deep": "#6e2a10", "base": "#b4512a", "highlight": "#c8693c", "header": "#7a3014", "accentLight": "#a8431d", "accentDark": "#f2925f", "texture": "textures/roland-garros-clay.jpg" },
    "australianOpen": { "label": "Australian Open", "surface": "hard", "deep": "#0b3d70", "base": "#1766b3", "highlight": "#3080cb", "header": "#0d4a86", "accentLight": "#1462ad", "accentDark": "#6ab4ff", "texture": "textures/australian-open-hard.png" },
    "usOpen": { "label": "US Open", "surface": "hard", "deep": "#1c3a62", "base": "#2e5c90", "highlight": "#4170a6", "header": "#4c7d43", "accentLight": "#2a5a8f", "accentDark": "#82b6ee", "texture": "textures/us-open-hard.png", "headerTexture": "textures/us-open-surround.png" }
  },
  "overlays": {
    "screenShadeLight": "rgba(0,0,0,0.22)",
    "screenShadeDark": "rgba(0,0,0,0.55)",
    "headerShade": "rgba(0,0,0,0.32)",
    "mowingStripes": "repeating-linear-gradient(135deg, rgba(255,255,255,.07) 0 70px, rgba(0,0,0,.08) 70px 140px)",
    "noteBackground": "rgba(0,0,0,0.32)",
    "textShadowOnCourt": "0 1px 3px rgba(0,0,0,0.7)"
  },
  "shape": {
    "cardRadius": 16, "noteRadius": 10, "segmentRadius": 9, "chipRadius": 999, "buttonRadius": 12, "iconRadius": 12,
    "screenGutter": 16, "rowMinHeight": 44, "rowPaddingX": 16, "sectionGap": 18,
    "chalkLine": { "width": 3, "color": "chalk" },
    "summaryBarBorder": "inset 0 0 0 3px deep, inset 0 0 0 5px chalk"
  },
  "language": {
    "default": "id",
    "supported": ["id", "en"],
    "thousandsSuffix": { "id": "rb", "en": "k" },
    "currency": "Rp, pemisah ribuan titik (600.000), diformat otomatis saat mengetik"
  }
}
